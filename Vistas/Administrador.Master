<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Administrador.master.cs" Inherits="Vistas.Administrador" %>

<!DOCTYPE html>

<html lang="es" data-bs-theme="dark">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel del Administrador</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <%--Carga de estilo desde el archivo--%>
    <link href="<%= ResolveUrl("~/Assets/css/admin-style.css") %>" rel="stylesheet" />

    <%--Fuente e iconos de la libreria Google Material Symbols--%>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />


    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body class="text-body-emphasis">

    <form id="form1" runat="server">

        <div class="d-flex">

            <aside class="sidebar flex-shrink-0 bg-body border-end p-4 d-flex flex-column justify-content-between">

                <div class="d-flex flex-column gap-4">
                    <div class="d-flex align-items-center gap-3 px-3">
                        <div class="bg-center bg-no-repeat bg-cover rounded-circle" data-alt="Company Logo Abstract Gradient" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuArGSoD0v-NnjntjtpoV6U_rmzfWOQERYN4pdmlqwCVGIoOfyFfGmNxCxpn4wE2wstTosiveMsrcDNzTcRccT-tNHnqyoC2ryK04tEAh-b3r7bNgfnoiFTSmzIUH_N11bqspydFPKTTsz1bzwa9AXxcngxJ2HfvCiksGHod5fLI7K6JngTmKXtlkTslZRr3KjEEFQiJfvHu8ezpEb2wXiidm2va2XxOO5VurhbwlVkXp5T3_-eGjmlwgx0N8ND4tqX4TRfVDtZpSaE"); width: 40px; height: 40px;'></div>
                        <div class="d-flex flex-column">
                            <h1 class="fs-6 fw-medium mb-0">Administrador</h1>
                            <p class="text-body-secondary small mb-0">Plataforma Curosos</p>
                        </div>
                    </div>

                    <nav class="nav nav-pills flex-column gap-2 mt-4">
                        <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="/Administrador/AdminPanel.aspx">
                            <span class="material-symbols-outlined fs-5">dashboard</span>
                            <span class="small fw-medium">Tablero</span>
                        </a>
                        <a class="nav-link d-flex text-body-secondary align-items-center gap-3" href="/Administrador/CursoPanel.aspx">
                            <span class="material-symbols-outlined fs-5">school</span>
                            <span class="small fw-medium">Cursos</span>
                        </a>
                        <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="/Administrador/CategoriaGestion.aspx">
                            <span class="material-symbols-outlined fs-5">category</span>
                            <span class="small fw-medium">Categorias</span>
                        </a>

                        <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="/Administrador/PagosPanel.aspx">
                            <span class="material-symbols-outlined fs-5">Checkbook</span>
                            <span class="small fw-medium">Panel de Pagos</span>
                        </a>

                        <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="#">
                            <span class="material-symbols-outlined fs-5">settings</span>
                            <span class="small fw-medium">Configuración</span>
                        </a>
                    </nav>
                </div>

                <div class="d-flex flex-column gap-1">
                    <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="#">
                        <span class="material-symbols-outlined fs-5">help</span>
                        <span class="small fw-medium">Ayuda</span>
                    </a>
                    <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="#">
                        <span class="material-symbols-outlined fs-5">logout</span>
                        <span class="small fw-medium">Cerrar Sesión</span>
                    </a>
                </div>
            </aside>

            <main class="flex-grow-1 overflow-y-auto">
                <div class="p-4 p-md-5">

                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>

                </div>

            </main>
        </div>

    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="<%= ResolveUrl("~/Assets/js/admin.js") %>"></script>
</body>
</html>
