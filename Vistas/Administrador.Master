<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Administrador.master.cs" Inherits="Vistas.AdministradorMaster" %>


<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel del Administrador</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="<%= ResolveUrl("~/Assets/css/styles.css") %>" rel="stylesheet" />
    <style>
        .btn-ver-catalogo {
            border: 1px solid rgba(13, 110, 253, 0.5);
            color: #0d6efd !important;
            transition: all 0.2s;
        }

            .btn-ver-catalogo:hover {
                background-color: #0d6efd;
                color: white !important;
            }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>

        <nav class="navbar navbar-expand-lg border-bottom shadow-sm bg-body" id="main-navbar">
            <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-5 text-body" href="/Administrador/AdminPanel.aspx">
                    <i class="bi bi-mortarboard-fill text-primary"></i>
                    Panel Administrador
                </a>


                <div class="flex-grow-1"></div>

                <div class="d-flex align-items-center">
                    <a href="#" class="nav-link fs-5 me-3" id="theme-toggler">
                        <i class="bi bi-sun" id="theme-icon"></i>
                    </a>

                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">


                            <asp:Image ID="imgAvatar" runat="server" alt="Avatar" Width="32" Height="32" class="rounded-circle me-2" />


                            <asp:Literal ID="litNombreUsuario" runat="server" Text="Usuario" />

                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" href="~/Administrador/PerfilAdministrador.aspx" runat="server">Mi Perfil</a></li>
                            <li>
                                <hr class="dropdown-divider" />
                            </li>
                            <li>

                                <asp:LinkButton ID="btnLogoutHeader" runat="server"
                                    CssClass="dropdown-item text-danger"
                                    OnClick="btnLogout_Click">
                             Cerrar sesión
                                </asp:LinkButton>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <div class="container-fluid">
            <div class="row">

                <aside class="col-md-3 col-lg-2 d-none d-md-block border-end vh-100 position-sticky bg-body" id="sidebar">
                    <div class="p-3">

                        <nav class="nav nav-pills flex-column gap-2">
                            <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="/Administrador/AdminPanel.aspx">
                                <i class="bi bi-speedometer2 fs-5"></i>
                                <span class="small fw-medium">Tablero</span>
                            </a>
                            <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="/Administrador/Curso/CursoPanel.aspx">
                                <i class="bi bi-book fs-5"></i>
                                <span class="small fw-medium">Cursos</span>
                            </a>
                            <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="/Administrador/CategoriaGestion.aspx">
                                <i class="bi bi-tags fs-5"></i>
                                <span class="small fw-medium">Categorias</span>
                            </a>
                            <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="/Administrador/GestionEntregas.aspx">
                                <i class="bi bi-clipboard-check fs-5"></i>
                                <span class="small fw-medium">Correcciones</span>
                            </a>
                            <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="/Administrador/PagosPanel.aspx">
                                <i class="bi bi-credit-card fs-5 "></i>
                                <span class="small fw-medium">Panel de Pagos</span>
                            </a>
                            <a class="nav-link text-body-secondary d-flex align-items-center gap-3" href="/Administrador/PerfilAdministrador.aspx">
                                <i class="bi bi-person fs-5 "></i>
                                <span class="small fw-medium">Perfil</span>
                            </a>





                        </nav>
                        <hr class="my-3 opacity-25">

                        <div class="d-grid">
                            <a href='<%= ResolveUrl("Home.aspx") %>' target="_blank" class="btn btn-sm btn-ver-catalogo d-flex align-items-center justify-content-center gap-2 py-2">
                                <i class="bi bi-shop-window"></i>
                                Ver Catálogo
                            </a>
                        </div>
                    </div>

                    <div class_="p-3 mt-auto border-top">
                        <asp:LinkButton ID="btnLogoutSidebar" runat="server"
                            CssClass="nav-link text-danger d-flex align-items-center gap-3">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                            <span class="small fw-medium">Cerrar Sesión</span>
                        </asp:LinkButton>
                    </div>
                </aside>

                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>

    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="<%= ResolveUrl("~/Assets/js/main.js") %>"></script>
    <
</body>
</html>
