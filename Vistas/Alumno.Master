<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Alumno.master.cs" Inherits="Vistas.AlumnoMaster" %>

<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel del Alumno</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="<%= ResolveUrl("~/Assets/css/styles.css") %>" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body>
    <form id="form1" runat="server">
        <!-- ¡¡CAMBIO 1: AGREGAMOS EL SCRIPTMANAGER!! (Obligatorio para los OnClick de los LinkButton) -->
        <asp:ScriptManager ID="ScriptManager1" runat="server" />

        <nav class="navbar navbar-expand-lg border-bottom shadow-sm bg-body" id="main-navbar">
            <div class="container-fluid px-4 d-flex justify-content-between align-items-center">

                

                <div class="flex-grow-1"></div>

                <div class="d-flex align-items-center">
                    <a href="#" class="nav-link fs-5 me-3" id="theme-toggler">
                        <i class="bi bi-sun" id="theme-icon"></i>
                    </a>

                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            
                            <!-- 
                                ¡¡CAMBIO 2: AVATAR DINÁMICO!!
                                Reemplazamos el <img> de HTML por un <asp:Image>
                                para poder controlarlo desde C#.
                            -->
                            <asp:Image ID="imgAvatar" runat="server" alt="Avatar" width="32" height="32" class="rounded-circle me-2" />
                            
                            <!-- 
                                ¡¡CAMBIO 3: NOMBRE DINÁMICO!!
                                Agregamos un Literal para poner "Pepito Rogelio" o "wxyz.25".
                            -->
                            <asp:Literal ID="litNombreUsuario" runat="server" Text="Usuario" />

                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item" href="~/Alumno/Perfil.aspx" runat="server">Mi Perfil</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <!-- 
                                    ¡¡CAMBIO 4: CONECTAMOS EL LOGOUT!!
                                    Agregamos el "OnClick" para que llame al C#
                                -->
                                <asp:LinkButton ID="btnLogoutHeader" runat="server" 
                                    CssClass="dropdown-item text-danger"
                                    OnClick="btnLogout_Click">
                                    Cerrar sesión
                                </asp:LinkButton>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <div class="container-fluid">
            <div class="row">
                <aside class="col-md-3 col-lg-2 d-none d-md-block border-end vh-100 position-sticky bg-body" id="sidebar">
                    <div class="p-3">
                        <h6 class="fw-bold text-secondary mb-3">Panel de Usuario</h6>
                        <ul class="nav flex-column">
                            <li class="nav-item mb-2">
                                <asp:HyperLink NavigateUrl="~/Alumno/MisCursos.aspx" CssClass="nav-link text-body-emphasis" runat="server">
                                    <i class="bi bi-book me-2 text-primary"></i>Mis Cursos
                                </asp:HyperLink>
                            </li>
                            <li class="nav-item mb-2">
                                <asp:HyperLink NavigateUrl="~/Alumno/PerfilAlumno.aspx" CssClass="nav-link text-body-emphasis" runat="server">
                                    <i class="bi bi-person me-2 text-primary"></i>Perfil
                                </asp:HyperLink>
                            </li>
                            <li class="nav-item mb-2">
                                <asp:HyperLink NavigateUrl="~/Alumno/MisPagos.aspx" CssClass="nav-link text-body-emphasis" runat="server">
                                    <i class="bi bi-credit-card me-2 text-primary"></i>Mis Pagos
                                </asp:HyperLink>
                            </li>
                            <li class="nav-item mb-2">
                                <asp:HyperLink NavigateUrl="~/Alumno/Certificados.aspx" CssClass="nav-link text-body-emphasis" runat="server">
                                    <i class="bi bi-award me-2 text-primary"></i>Certificados
                                </asp:HyperLink>
                            </li>
                            <li class="nav-item mb-2">
                                <asp:HyperLink NavigateUrl="~/Alumno/Aula.aspx" CssClass="nav-link text-body-emphasis" runat="server">
                                    <i class="bi bi-easel me-2 text-primary"></i>Aula
                                </asp:HyperLink>
                            </li>
                            
                            <li class="nav-item mt-4 pt-2 border-top">
                                <asp:HyperLink NavigateUrl="~/Home.aspx" CssClass="nav-link text-body-emphasis" runat="server">
                                    <i class="bi bi-compass me-2 text-info"></i>Ir al Catálogo
                                </asp:HyperLink>
                            </li>
                            
                            <li class="nav-item mt-2">
                                <!-- 
                                    ¡¡CAMBIO 5: CONECTAMOS EL LOGOUT 2!!
                                    Agregamos el "OnClick" también al botón del sidebar.
                                -->
                                <asp:LinkButton ID="btnLogoutSidebar" runat="server" 
                                    CssClass="nav-link text-danger"
                                    OnClick="btnLogout_Click">
                                    <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                </asp:LinkButton>
                            </li>
                        </ul>
                    </div>
                </aside>

                <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                </main>
            </div>
        </div>

        <footer class="border-top mt-5 py-3 text-center text-muted small bg-body">
            © <%= DateTime.Now.Year %> Plataforma LMS — Todos los derechos reservados.
        </footer>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <!-- Tu main.js ya se encarga del DarkMode -->
    <script src="<%= ResolveUrl("~/Assets/js/main.js") %>"></script>
</body>
</html>